# Dependencias (api/ y web/ tienen además su propio .gitignore con el detalle)
node_modules/
vendor/

# Entornos. Las negaciones van DESPUÉS del patrón que las captura; al revés
# no aplican y los archivos de ejemplo quedarían fuera del repo.
.env
.env.*
!.env.example
!.env.production.example

# Salidas de build
.next/
.vercel/

# Logs
*.log
npm-debug.log*

# Sistema operativo
.DS_Store
Thumbs.db

# Editores
.idea/
.vscode/
*.swp

# Insumos de diseño que se bajan aparte (maquetas, exportes del sistema).
# Pesan y no se consumen desde el código: los assets que sí se usan viven en
# web/public/.
*.zip

# Skills instaladas con `npx skills add`. El lockfile SÍ se versiona —dice qué
# skill y qué versión se usó—; el contenido descargado no, que se reinstala
# desde ahí. .claude/skills son enlaces simbólicos a .agents/skills.
.agents/skills/
.claude/
