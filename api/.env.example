APP_NAME="Daniel Buitrón · Barista"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local (desarrollo): SQLite por defecto, sin servidor.
DB_CONNECTION=sqlite

# Producción: PostgreSQL. Para correrlo en local, descomenta y ajusta:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=barista
# DB_USERNAME=barista
# DB_PASSWORD=
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# El chatbot despacha su trabajo a la cola: WhatsApp espera un 200 en segundos
# y una vuelta del modelo tarda más. Con "database" hay que dejar corriendo
# `php artisan queue:work`; en producción, un supervisor que lo mantenga vivo.
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ───────────────────────────────────────────────────────────────────────────────
# Tienda — configuración de la app (se lee vía config/tienda.php)
# ───────────────────────────────────────────────────────────────────────────────

# Token Bearer de la API de administración. En producción: largo y aleatorio.
# Genéralo con:  php -r "echo bin2hex(random_bytes(32));"
ADMIN_TOKEN=cambia-esto-por-uno-aleatorio

# Orígenes permitidos para CORS (coma-separados, sin barra final).
# OBLIGATORIO en producción. Ej: CORS_ALLOWED_ORIGINS=https://danielbuitron.co
CORS_ALLOWED_ORIGINS=

# TIENDA_TIMEZONE=America/Bogota

# Imágenes subidas: se reducen al lado máximo indicado y se pasan a WebP.
MAX_IMAGE_PX=1800
IMAGE_QUALITY=87

# Videos subidos: se recomprimen con FFmpeg (720p, H.264 CRF 30, sin audio).
# Si ffmpeg no está en el PATH del servidor, indica la ruta del binario:
# FFMPEG_PATH=/usr/bin/ffmpeg
# MAX_VIDEO_PX=720
# VIDEO_CRF=30

# ───────────────────────────────────────────────────────────────────────────────
# Chatbot de administración (WhatsApp Cloud API + Claude)
# ───────────────────────────────────────────────────────────────────────────────

# Números autorizados, formato E.164 SIN el "+", separados por coma.
# Es la única barrera entre WhatsApp y la base de datos: si queda vacía, el
# bot ignora todos los mensajes. Ej: CHATBOT_ADMINS=573001112233,573009998877
CHATBOT_ADMINS=

# Lo que inventas tú y le pegas a Meta al registrar el webhook.
CHATBOT_VERIFY_TOKEN=

# Secreto de la app de Meta (App Dashboard → Configuración → Básica).
# Con él se valida la firma HMAC de cada webhook. Sin esto en producción, el
# endpoint queda abierto a internet y se rechazan todas las peticiones.
CHATBOT_APP_SECRET=

# Del número de WhatsApp Business: id del teléfono y token de acceso permanente.
CHATBOT_PHONE_ID=
CHATBOT_ACCESS_TOKEN=

# Clave de la API de Claude (console.anthropic.com).
ANTHROPIC_API_KEY=
# CHATBOT_MODELO=claude-opus-5
# CHATBOT_MEMORIA_TURNOS=12
# CHATBOT_MEMORIA_MINUTOS=30

# ───────────────────────────────────────────────────────────────────────────────
# PRODUCCIÓN — lista de chequeo (NO dejar valores de desarrollo):
#   APP_ENV=production
#   APP_DEBUG=false                  # nunca true en prod (filtra trazas y secretos)
#   APP_URL=https://api.tudominio.co
#   php artisan key:generate         # APP_KEY único por entorno
#   php artisan storage:link         # para servir imágenes en /storage
#   php artisan config:cache route:cache
#   Un worker de cola vivo:  php artisan queue:work --tries=2
# ───────────────────────────────────────────────────────────────────────────────
