# ── Sitio — variables para correr en local ──
# Copia este archivo a `.env.local` y ajusta los valores. `.env.local` no se
# sube al repositorio.

# A dónde apunta el proxy de Next. Es una variable de SERVIDOR: no lleva
# NEXT_PUBLIC_ porque el navegador no debe conocer la URL del backend. Todas
# las peticiones salen por /api-tienda/* y /tienda-storage/*, que Next
# reescribe hacia acá.
#
# 8001 es el puerto por defecto de `php artisan serve` en el backend. Si lo
# levantas en otro, cámbialo en las dos variables.
BACKEND_URL=http://localhost:8001

# La misma URL, pero con /api. La usa el render del servidor para pegarle
# directo al backend sin dar la vuelta por el proxy.
API_INTERNA=http://localhost:8001/api

# Número al que llegan los pedidos, en formato internacional sin "+",
# sin espacios y sin guiones — es como lo espera wa.me.
NEXT_PUBLIC_WHATSAPP=573227323425

# ── Panel de administración (/admin) ──
# Con esta contraseña se entra al panel. Nunca llega al navegador: el servidor
# de Next la compara y devuelve el token de abajo.
ADMIN_PASSWORD=cambia-esta-contrasena

# Token Bearer con el que el panel le habla a la API. Debe ser EXACTAMENTE el
# mismo valor que ADMIN_TOKEN en el `.env` del backend, o el panel recibe 401
# en todo.
ADMIN_TOKEN=cambia-esto-por-uno-aleatorio
