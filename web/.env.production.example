# ── Sitio (Vercel) — variables de producción ──
# Cópialas en Vercel → Project → Settings → Environment Variables, entorno
# Production. Ver DESPLIEGUE.md para el resto del proceso.

# A dónde apunta el proxy de Next. Es una variable de SERVIDOR: no lleva
# NEXT_PUBLIC_ porque el navegador no debe conocer la URL del backend. Todas
# las peticiones del sitio salen por /api-tienda/* y /tienda-storage/*, que
# Next reescribe hacia acá.
BACKEND_URL=https://barista-api.onrender.com

# La misma URL, pero con /api. La usa el render del servidor para pegarle
# directo al backend sin dar la vuelta por el proxy.
API_INTERNA=https://barista-api.onrender.com/api

# Número al que llegan los pedidos, en formato internacional sin "+",
# sin espacios y sin guiones — es como lo espera wa.me.
# PROVISIONAL: número de pruebas mientras llega la línea de WhatsApp Business.
NEXT_PUBLIC_WHATSAPP=573227323425

# El backend llama a /api/revalidar con este secreto después de cada cambio,
# para que el sitio se regenere de una en vez de esperar el minuto del caché.
# Debe ser EXACTAMENTE el mismo valor que REVALIDAR_SECRETO en el backend.
REVALIDAR_SECRETO=

# ── Panel de administración (/admin) ──
# Con esta contraseña se entra al panel. Nunca llega al navegador: el servidor
# de Next la compara y devuelve el token de abajo.
ADMIN_PASSWORD=

# Token Bearer con el que el panel le habla a la API. Debe ser EXACTAMENTE el
# mismo valor que ADMIN_TOKEN en el backend, o el panel recibe 401 en todo.
ADMIN_TOKEN=
