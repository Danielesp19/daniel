APP_NAME="Daniel Buitrón · Barista"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local (desarrollo): SQLite por defecto, sin servidor.
DB_CONNECTION=sqlite

# Producción: PostgreSQL. Para correrlo en local, descomenta y ajusta:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=barista
# DB_USERNAME=barista
# DB_PASSWORD=
# DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CACHE_STORE=database

# Hoy no hay trabajos en cola —el único era el del chatbot, que se descartó—,
# pero la conexión se deja configurada para cuando vuelva a hacer falta.
QUEUE_CONNECTION=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hola@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ───────────────────────────────────────────────────────────────────────────────
# Tienda — configuración de la app (se lee vía config/tienda.php)
# ───────────────────────────────────────────────────────────────────────────────

# Token Bearer de la API de administración. En producción: largo y aleatorio.
# Genéralo con:  php -r "echo bin2hex(random_bytes(32));"
ADMIN_TOKEN=cambia-esto-por-uno-aleatorio

# Orígenes permitidos para CORS (coma-separados, sin barra final).
# OBLIGATORIO en producción. Ej: CORS_ALLOWED_ORIGINS=https://danielbuitron.co
CORS_ALLOWED_ORIGINS=

# TIENDA_TIMEZONE=America/Bogota

# URL pública del sitio. Sirve para avisarle que el catálogo cambió, así el
# admin ve el cambio de una y no dentro de un minuto. El secreto debe ser el
# MISMO que REVALIDAR_SECRETO en el frontend.
SITIO_URL=http://localhost:3000
REVALIDAR_SECRETO=cambia-esto-tambien

# Imágenes subidas: se reducen al lado máximo indicado y se pasan a WebP.
MAX_IMAGE_PX=1800
IMAGE_QUALITY=87

# Videos subidos: se recomprimen con FFmpeg (720p, H.264 CRF 30, sin audio).
# Si ffmpeg no está en el PATH del servidor, indica la ruta del binario:
# FFMPEG_PATH=/usr/bin/ffmpeg
# MAX_VIDEO_PX=720
# VIDEO_CRF=30

# ───────────────────────────────────────────────────────────────────────────────
# PRODUCCIÓN — lista de chequeo (NO dejar valores de desarrollo):
#   APP_ENV=production
#   APP_DEBUG=false                  # nunca true en prod (filtra trazas y secretos)
#   APP_URL=https://api.tudominio.co
#   php artisan key:generate         # APP_KEY único por entorno
#   php artisan storage:link         # para servir imágenes en /storage
#   php artisan config:cache route:cache
# ───────────────────────────────────────────────────────────────────────────────

# A dónde llegan las preguntas que deja la gente en la página. Vacío = solo se
# guardan en la base y se leen desde el panel (Buzón). Cuando exista el correo
# corporativo, ponlo acá y además llegará un aviso por correo.
CONSULTAS_CORREO=
